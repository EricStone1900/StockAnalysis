{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-analysis.local/schemas/domain-event-envelope.v1.json",
  "title": "DomainEventEnvelope",
  "type": "object",
  "required": ["eventId", "subject", "schemaVersion", "occurredAt", "availableAt", "producer", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "subject": { "type": "string", "pattern": "^stock\\.[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+\\.v[1-9][0-9]*$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "availableAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string" },
    "correlationId": { "type": "string" },
    "causationId": { "type": "string" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
